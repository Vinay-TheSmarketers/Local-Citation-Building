{
  "name": "vlc-local-citation-builder",
  "version": "1.0.0",
  "private": true,
  "description": "Smarketers vLC — local citation auditing, tracking, and assisted submission automation.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "browser:install": "playwright install chromium",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts && playwright install chromium"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "@radix-ui/react-slot": "1.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "15.5.23",
    "playwright": "1.55.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sonner": "2.0.7",
    "tailwind-merge": "2.5.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "22.10.2",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-config-next": "15.5.23",
    "postcss": "8.4.49",
    "prisma": "6.16.2",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
